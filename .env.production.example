# Copy this file to .env.production and replace every placeholder before deploy.

POSTGRES_USER=metric_admin
POSTGRES_PASSWORD=..............gres-password
TIMESCALE_DB_USER=metric_admin
TIMESCALE_DB_PASSWORD=...............cale-password
MONGODB_USER=metric_admin
MONGODB_PASSWORD=..............odb-password
RABBITMQ_DEFAULT_USER=metric_admin
RABBITMQ_DEFAULT_PASS=..............itmq-password

AUTH_DATABASE_URI=postgresql://metric_admin:..............gres-password@postgres:5432/metric_auth
USERS_DATABASE_URI=postgresql://metric_admin:..............gres-password@postgres:5432/metric_users
PROCESSING_DATABASE_URI=postgresql://metric_admin:...............cale-password@timescale:5432/metric_calc?schema=metrics
ANALYTICS_DATABASE_URI=postgresql://metric_admin:...............cale-password@timescale:5432/metric_calc?schema=analytics
COLLECTOR_DATABASE_URI=mongodb://metric_admin:..............odb-password@mongo:27017/metric_collector?authSource=admin

RABBITMQ_URI=amqp://metric_admin:..............itmq-password@rabbitmq:5672
RABBITMQ_QUEUE=raw_events
RABBITMQ_EXCHANGE=events

JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
JWT_ACCESS_TOKEN_TTL=7d
JWT_REFRESH_TOKEN_TTL=20d

GATEWAY_PUBLIC_URL=https://api.example.com
COLLECTOR_PUBLIC_URL=https://collector.example.com
FRONTEND_URL=https://app.example.com
HTTP_CORS=https://app.example.com
COOKIES_DOMAIN=example.com
COOKIES_SECRET=................-signing-secret

GITHUB_CLIENT_ID=......e-me
GITHUB_CLIENT_SECRET=......e-me
GITHUB_CALLBACK_URL=https://api.example.com/auth/github/callback
GITHUB_TOKEN=...........replace_me
GITHUB_WEBHOOK_SECRET=................-webhook-secret
GITHUB_ALLOWED_ORGS=example-org

VITE_GATEWAY_URL=https://api.example.com

JAEGER_URL=http://jaeger:4317
AUTH_LOG_LEVEL=info

FRONTEND_PORT=3000
GATEWAY_PORT=4000
COLLECTOR_PORT=4001
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
