LOG_LEVEL="info"
LOG_PATH="/var/log/services/auth/auth.log"

GRPC_HOST="0.0.0.0"
GRPC_PORT=50051

USERS_GRPC_URL="localhost:50052"

DATABASE_URI="postgresql://postgres:....56@metric-postgres:5432/metric_auth"

JWT_PRIVATE_KEY_PATH="./keys/jwt-private.pem"
JWT_PUBLIC_KEY_PATH="./keys/jwt-public.pem"
JWT_ACCESS_TOKEN_TTL="7d"
JWT_REFRESH_TOKEN_TTL="20d"


JAEGER_URL="metric-jaeger:4317"
